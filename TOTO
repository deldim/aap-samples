<div style="display:flex; align-items:center; justify-content:center; padding:1rem 0;">
  <div style="position:relative; width:220px; height:220px;">
    <svg id="donut-svg" viewBox="0 0 200 200" style="width:100%; height:100%;"></svg>
    <div style="position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center;">
      <div id="total-value" style="font-size:28px; font-weight:500; color:var(--text-primary);"></div>
      <div style="font-size:12px; color:var(--text-secondary);">Total</div>
    </div>
  </div>
</div>
<script>
(function() {
  const data = [
    { label: "Service A", value: 420, cls: "c-blue" },
    { label: "Service B", value: 310, cls: "c-teal" },
    { label: "Service C", value: 180, cls: "c-coral" },
    { label: "Service D", value: 90,  cls: "c-purple" }
  ];
  const colorHex = { "c-blue": "#378ADD", "c-teal": "#1D9E75", "c-coral": "#D85A30", "c-purple": "#7F77DD" };
  const total = data.reduce((s, d) => s + d.value, 0);
  document.getElementById('total-value').textContent = total.toLocaleString('fr-FR');

  const svg = document.getElementById('donut-svg');
  const cx = 100, cy = 100, rOuter = 90, rInner = 55;
  let angle = -90;

  function polar(cx, cy, r, a) {
    const rad = (a * Math.PI) / 180;
    return { x: cx + r * Math.cos(rad), y: cy + r * Math.sin(rad) };
  }
  function slice(cx, cy, rI, rO, a0, a1) {
    const so = polar(cx, cy, rO, a0), eo = polar(cx, cy, rO, a1);
    const si = polar(cx, cy, rI, a1), ei = polar(cx, cy, rI, a0);
    const large = a1 - a0 > 180 ? 1 : 0;
    return `M ${so.x} ${so.y} A ${rO} ${rO} 0 ${large} 1 ${eo.x} ${eo.y} L ${si.x} ${si.y} A ${rI} ${rI} 0 ${large} 0 ${ei.x} ${ei.y} Z`;
  }

  data.forEach(d => {
    const sweep = (d.value / total) * 360;
    const a0 = angle, a1 = angle + sweep;
    angle = a1;
    const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
    path.setAttribute("d", slice(cx, cy, rInner, rOuter, a0, a1));
    path.setAttribute("fill", colorHex[d.cls]);
    path.setAttribute("stroke", "var(--surface-2)");
    path.setAttribute("stroke-width", "1.5");
    const title = document.createElementNS("http://www.w3.org/2000/svg", "title");
    title.textContent = `${d.label}: ${d.value} (${((d.value/total)*100).toFixed(1)}%)`;
    path.appendChild(title);
    svg.appendChild(path);
  });
})();
</script>
